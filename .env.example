# DevisPlus — per-customer deployment settings (copy to .env.local for local dev).
# Placeholders only. Real values go in the deployment's secret settings
# (Cloudflare: `wrangler secret put NAME` or the dashboard), never in git.

# Public site address used for canonical URLs, sitemap and social previews (no trailing slash).
# Build-time value (VITE_ prefix): set it when building each deployment.
VITE_SITE_URL=https://devisplus.ma

# Public address of THIS customer's deployment (no trailing slash).
APP_URL=http://localhost:8080

# --- Google Drive (server-side only; never prefix these with VITE_) ---
# OAuth client of THIS customer's Google Cloud project ("Web application" type).
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-the-client-secret
# Must be APP_URL + /api/google/callback and be listed in the OAuth client's redirect URIs.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
# 32 random bytes, base64. Generate one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it disconnects Google Drive (sealed tokens can no longer be read).
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64

# --- Accounts and data (server-side only) ---
# Pooled Neon connection used by the app's server; DATABASE_URL_UNPOOLED is only for npm run db:migrate.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Random, at least 32 characters, different per deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# --- Business model of THIS deployment (see docs/client-setup.md) ---
# approval (default): anyone signs up, you accept each company in the admin portal
# closed: no sign-up; you create the customer accounts in the admin portal
# open: sign-ups are accepted at once
SIGNUP_MODE=approval
# Admin portal on its own host (only /admin there; /admin elsewhere moves to it). Empty: /admin everywhere.
ADMIN_HOST=
# Emails that become platform admins at their first Google sign-in (or use: npm run admin:grant -- email).
PLATFORM_ADMIN_EMAILS=contact@devisplus.ma
# Other addresses this deployment answers on, comma-separated (e.g. a second domain).
APP_ORIGINS=

# --- Customers' own domains on the shared app (Cloudflare for SaaS, optional) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CUSTOM_DOMAIN_TARGET=

# --- Emails (optional): "Mot de passe oublié" sends a reset link when both are set ---
# Without them, users ask the DevisPlus team, who set a new password in the admin portal.
RESEND_API_KEY=
EMAIL_FROM=DevisPlus <no-reply@devisplus.ma>
